<!doctype html>
<html lang="en" class="no-js">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<title>Arpit Agrawal — Web Designer-Developer</title>

		<link rel="stylesheet" href="/assets/styles/index.css" />
		<!--TODO: update print stylesheet-->
		<link rel="stylesheet" href="/assets/styles/print.css" media="print" />

		<script type="module">
			document.documentElement.classList.remove("no-js");
			document.documentElement.classList.add("js");
		</script>

		<!--TODO: subset the fonts-->
		<style>
			@font-face {
				font-family: "Jakob Semi-Condensed";
				src: url("/assets/fonts/Jakob-Semi-Condensed.woff2");
				font-weight: 400;
				font-stretch: 87.5%;
				font-display: swap;
			}

			@font-face {
				font-family: "Adjusted Arial Narrow Fallback";
				src: local(Arial Narrow);
				size-adjust: 76%;
				ascent-override: normal;
				descent-override: normal;
				line-gap-override: 15%;
			}

			@font-face {
				font-family: "Inter";
				src: url("/assets/fonts/InterVariable-ascii-sliced.woff2");
				font-display: swap;
				font-weight: 350 700;
				unicode-range:
					U+0000, U+0020-007E, U+00A9, U+2014, U+2191, U+E1D2, U+E1D7;
			}

			@font-face {
				font-family: "Adjusted Arial Fallback";
				size-adjust: 107%;
				src: local("Arial");
			}
		</style>

		<meta
			name="description"
			content="Web designer-developer in Mumbai, India. I focus on semantic HTML, modern CSS and accessibility to create interfaces that work everywhere, including in your framework of choice.
"
		/>
		<meta
			property="og:title"
			content="Arpit Agrawal — Web Designer-Developer in Mumbai, India"
		/>
		<meta
			property="og:description"
			content="Web designer-developer in Mumbai, India. I focus on semantic HTML, modern CSS and accessibility to create interfaces that work everywhere, including in your framework of choice.
"
		/>

		<!--TODO: optimise opengraph image and add image alt-->
		<meta
			property="og:image"
			content="https://arpit.codes/assets/img/og.jpeg"
		/>
		<!--<meta property="og:image:alt" content="Image description" />-->
		<meta property="og:locale" content="en_IN" />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta property="og:url" content="https://arpit.codes/" />
		<link rel="canonical" href="https://arpit.codes/" />

		<!--TODO: generate favicons and web manifest-->
		<!--<link rel="icon" href="/favicon.ico" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/my.webmanifest" />-->
	</head>
	<body class="{{ pageClass or '' }} character-variants-5">
		{% include 'components/skip-link.njk' %}
		{% include 'components/site-header.njk' %}

		{{ content | safe }}

		{% include 'components/site-footer.njk' %}
	</body>
</html>
